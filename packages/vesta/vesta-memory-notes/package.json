{
  "name": "@deepseek-ai/dsh-vesta-memory-notes",
  "description": "Vesta host plugin: automatic memory capture after idle turns and recall before every prompt, over the memory MCP",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
