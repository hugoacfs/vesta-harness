{
  "name": "@deepseek-ai/dsh-vesta-notify",
  "description": "Vesta notify: Telegram pings through the send-only notifier MCP when a long turn finishes or an approval waits while no browser tab is looking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
