{
  "name": "@deepseek-ai/dsh-vesta-app",
  "description": "Vesta Harness as a profile bundle: the Vesta patch layer over dsh-web-app (ember theme, Vesta brand, vesta MCP servers)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-vesta-brand": "workspace:^",
    "@deepseek-ai/dsh-client-ui-vesta-presence": "workspace:^",
    "@deepseek-ai/dsh-client-ui-vesta-routines": "workspace:^",
    "@deepseek-ai/dsh-client-ui-vesta-sessions": "workspace:^",
    "@deepseek-ai/dsh-client-ui-vesta-theme": "workspace:^",
    "@deepseek-ai/dsh-client-ui-vesta-voice": "workspace:^",
    "@deepseek-ai/dsh-hooks-claude-code": "workspace:^",
    "@deepseek-ai/dsh-mcp-client": "workspace:^",
    "@deepseek-ai/dsh-schedule": "workspace:^",
    "@deepseek-ai/dsh-session-title-all-prompts-llm": "workspace:^",
    "@deepseek-ai/dsh-time-context": "workspace:^",
    "@deepseek-ai/dsh-tool-session-query": "workspace:^",
    "@deepseek-ai/dsh-vesta-incognito": "workspace:^",
    "@deepseek-ai/dsh-vesta-modes": "workspace:^",
    "@deepseek-ai/dsh-vesta-notify": "workspace:^",
    "@deepseek-ai/dsh-vesta-routines": "workspace:^",
    "@deepseek-ai/dsh-vesta-sessions": "workspace:^",
    "@deepseek-ai/dsh-vesta-voice": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
