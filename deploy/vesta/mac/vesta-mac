#!/bin/bash
# vesta-mac on|off|status — let the Vesta harness (staging) use this Mac's shell and files.
#
# Nothing listens on the network: a user-level sshd on 127.0.0.1:2222 (no system setting
# touched, your account only, key-only) plus a reverse tunnel to Vesta over your ordinary
# `ssh vesta` key, so Vesta reaches 127.0.0.1:2222 on its own side. Access exists while on.
set -u
D="$HOME/.vesta-mac"
SSHD_PID="$D/sshd.pid"; TUNNEL_PID="$D/tunnel.pid"
alive() { [ -s "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }
case "${1:-status}" in
  on)
    if ! alive "$SSHD_PID"; then
      /usr/sbin/sshd -f "$D/sshd_config" -E "$D/sshd.log" || { echo "sshd did not start; see $D/sshd.log"; exit 1; }
      sleep 0.5
    fi
    if ! alive "$TUNNEL_PID"; then
      : > "$TUNNEL_PID"
      nohup bash "$D/tunnel-loop" >/dev/null 2>&1 &
      echo $! > "$TUNNEL_PID"
    fi
    sleep 6
    "$0" status ;;
  off)
    if [ -s "$TUNNEL_PID" ]; then kill "$(cat "$TUNNEL_PID")" 2>/dev/null; fi
    rm -f "$TUNNEL_PID"
    pkill -f 'ssh -N .*tunnel_ed25519' 2>/dev/null
    alive "$SSHD_PID" && kill "$(cat "$SSHD_PID")"
    sleep 0.5
    echo "vesta-mac: off" ;;
  status)
    s=off; t=off
    alive "$SSHD_PID" && s="on"
    pgrep -f 'ssh -N .*tunnel_ed25519' >/dev/null && t=on
    echo "vesta-mac: sshd $s, tunnel to vesta $t" ;;
  *) echo "usage: vesta-mac on|off|status"; exit 2 ;;
esac
