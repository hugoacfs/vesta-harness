{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/hugo/.vesta-harness/hooks/guard-shell.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__home-assistant__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/hugo/.vesta-harness/hooks/guard-ha-mcp.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
