#!/usr/bin/env python3
"""vesta-call-check — a synthetic caller for the Harness voice path.

Joins the LiveKit room of one Session exactly like a browser would (a
STANDARD participant with a microphone track), plays a WAV of spoken speech
into the room, and reports what the agent did: its published `lk.agent.state`
transitions, the audio it spoke back (frames received), and the transcript
the STT sidecar produced. Run inside the agent container (it has the SDKs and
the LiveKit credentials):

  docker exec -i livekit-agent python - <sessionId> </path/inside/container.wav

  vesta-call-check <sessionId> <wav path>[,<wav path>...] [seconds to wait per reply, default 40] [settle seconds, default 0]
The session id is `session-<uuid>` (a bare uuid is prefixed). The agent log must show
`bridge bound: room=dsh-session-…` for the run; `bridge unavailable … falling back to direct
mode` means the call never reached the harness and the reply came from Qwen directly.
Environment: GREETING_WAIT_S (default 30) how long to wait for the greeting to finish before the
first WAV; PLAY_AFTER_S (default 0) with GREETING_WAIT_S=0 plays the first WAV this long after
joining, i.e. over the greeting, for a barge-in check; BARGE_AFTER_S (default 0) plays the second
WAV this long after the first reply starts, i.e. over it. Silence is streamed between WAVs.

Each WAV is one spoken turn, played after the previous reply ended; the settle
wait at the end catches speech the agent produces without being asked (the
continuation after a spoken approval).
"""
import asyncio
import os
import sys
import time
import wave

from livekit import api, rtc

LIVEKIT_URL = "ws://192.168.0.2:7880"
PREFIX = "dsh-"


def token(room: str) -> str:
    t = (
        api.AccessToken()  # LIVEKIT_API_KEY / LIVEKIT_API_SECRET from the environment
        .with_identity(f"probe-{int(time.time()) % 100000}")
        .with_name("Probe")
        .with_grants(api.VideoGrants(room_join=True, room=room, can_publish=True, can_subscribe=True))
    )
    if AGENT_NAME:
        # only for an SFU that honours dispatch by token; the vesta one does not (see agent.py)
        t = t.with_room_config(api.RoomConfiguration(agents=[api.RoomAgentDispatch(agent_name=AGENT_NAME)]))
    return t.to_jwt()


async def play(source: rtc.AudioSource, path: str, lock: asyncio.Lock) -> None:
    async with lock:   # the silence feeder must not capture into the source at the same time
        with wave.open(path, "rb") as wav:
            rate, channels, width = wav.getframerate(), wav.getnchannels(), wav.getsampwidth()
            assert width == 2, "16-bit PCM expected"
            chunk = rate // 100  # 10 ms
            while True:
                data = wav.readframes(chunk)
                if not data:
                    break
                frame = rtc.AudioFrame(data=data, sample_rate=rate, num_channels=channels, samples_per_channel=len(data) // (2 * channels))
                await source.capture_frame(frame)
        await source.wait_for_playout()


async def main(session_id: str, wav_path: str, wait_s: float) -> int:
    # Session ids are `session-<uuid>` and bridge rooms `dsh-session-<uuid>`; a bare uuid
    # would make a room the harness refuses (404) and the agent would answer in direct mode
    # (Qwen straight from LiteLLM), which looks like a working call but never reaches the harness.
    if not session_id.startswith("session-"):
        session_id = f"session-{session_id}"
    room_name = f"{PREFIX}{session_id}"
    with wave.open(wav_path.split(",")[0], "rb") as wav:
        rate, channels = wav.getframerate(), wav.getnchannels()   # every WAV must share this format
    room = rtc.Room()
    states: list[tuple[float, str]] = []
    heard = {"frames": 0, "ms": 0.0}
    t0 = time.monotonic()

    @room.on("participant_attributes_changed")
    def _attrs(changed: dict, participant: rtc.Participant) -> None:
        state = changed.get("lk.agent.state")
        if state:
            states.append((round(time.monotonic() - t0, 1), state))
            print(f"  [{states[-1][0]:5.1f}s] agent state: {state}", flush=True)

    @room.on("track_subscribed")
    def _sub(track: rtc.Track, publication: rtc.RemoteTrackPublication, participant: rtc.RemoteParticipant) -> None:
        print(f"  subscribed to {participant.identity} {track.kind}", flush=True)
        if track.kind == rtc.TrackKind.KIND_AUDIO:
            asyncio.ensure_future(count(rtc.AudioStream(track)))

    async def count(stream: rtc.AudioStream) -> None:
        async for event in stream:
            heard["frames"] += 1
            heard["ms"] += event.frame.samples_per_channel / event.frame.sample_rate * 1000

    await room.connect(LIVEKIT_URL, token(room_name))
    print(f"joined {room_name} as {room.local_participant.identity}", flush=True)
    for p in room.remote_participants.values():
        state = p.attributes.get("lk.agent.state")
        if state:
            states.append((0.0, state))
            print(f"  [  0.0s] agent state: {state} (on join)", flush=True)
    source = rtc.AudioSource(rate, channels)
    track = rtc.LocalAudioTrack.create_audio_track("microphone", source)
    await room.local_participant.publish_track(track, rtc.TrackPublishOptions(source=rtc.TrackSource.SOURCE_MICROPHONE))
    # A browser microphone never stops: feed silence between the WAVs so the agent's listener
    # sees a continuous timeline (its gate and keepalive only make sense against one).
    lock = asyncio.Lock()

    async def silence() -> None:
        frame = rtc.AudioFrame.create(rate, channels, rate // 50)   # 20 ms of zeros
        while True:
            async with lock:
                await source.capture_frame(frame)   # paced by the source's own queue
            await asyncio.sleep(0)

    feeder = asyncio.ensure_future(silence())
    # Let the agent link and, when the harness warms the prefix with a greeting turn,
    # finish speaking that greeting (speaking → listening) before the first question.
    greet_deadline = time.monotonic() + float(os.environ.get("GREETING_WAIT_S", "30"))
    # GREETING_WAIT_S=0 with PLAY_AFTER_S=2: talk over the greeting (barge-in check).
    play_after = float(os.environ.get("PLAY_AFTER_S", "0"))
    # BARGE_AFTER_S=4: play the second WAV this long after the first reply starts, i.e. over it.
    barge_after = float(os.environ.get("BARGE_AFTER_S", "0"))
    spoke = False
    while time.monotonic() < greet_deadline:
        await asyncio.sleep(0.2)
        if any(s == "speaking" for _, s in states):
            spoke = True
        if spoke and states and states[-1][1] == "listening":
            break
    if spoke:
        print(f"  greeting finished {time.monotonic() - t0:.1f}s after join", flush=True)
    else:
        print("  no greeting heard before the deadline", flush=True)
    settle_s = float(sys.argv[4]) if len(sys.argv) > 4 else 0.0
    if play_after > 0:
        await asyncio.sleep(max(0.0, play_after - (time.monotonic() - t0)))
    for n, path in enumerate(wav_path.split(","), 1):
        print(f"playing {path} (round {n}) at {time.monotonic() - t0:.1f}s...", flush=True)
        await play(source, path, lock)
        asked = time.monotonic()
        print("question played; waiting for the reply...", flush=True)
        first_speech = None
        deadline = asked + wait_s
        while time.monotonic() < deadline:
            await asyncio.sleep(0.2)
            later = [(t, s) for t, s in states if t0 + t >= asked]
            if first_speech is None and any(s == "speaking" for _, s in later):
                first_speech = next(t0 + t for t, s in later if s == "speaking")
                print(f"  reply started {first_speech - asked:.1f}s after the question ended", flush=True)
            if first_speech is not None and later and later[-1][1] == "listening" and t0 + later[-1][0] > first_speech:
                break
            if first_speech is not None and barge_after > 0 and n == 1 and time.monotonic() >= first_speech + barge_after:
                print(f"  barging in {barge_after:.0f}s into the reply", flush=True)
                break
        if first_speech is None:
            print("  no reply within the wait", flush=True)
        if not (barge_after > 0 and n == 1):
            await asyncio.sleep(1.0)
    if settle_s > 0:
        print(f"settling {settle_s:.0f}s for unprompted speech...", flush=True)
        await asyncio.sleep(settle_s)
    feeder.cancel()
    await room.disconnect()
    print(f"agent audio received: {heard['frames']} frames, {heard['ms'] / 1000:.1f}s")
    print("states:", " -> ".join(s for _, s in states) or "(none)")
    spoke = heard["ms"] > 500
    return 0 if spoke else 2


if __name__ == "__main__":
    if len(sys.argv) < 3:
        print(__doc__)
        raise SystemExit(64)
    sys.exit(asyncio.run(main(sys.argv[1], sys.argv[2], float(sys.argv[3]) if len(sys.argv) > 3 else 40.0)))
